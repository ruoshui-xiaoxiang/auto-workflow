    got = relocate(got, Path(ctx["batch_dir"]) / str(p.get("stage", "video")), ctx["log"])
    log(ctx, f"[video] 完成 {len(got)} 个（{time.time() - t0:.1f}s）")
    return {"files": got, "seed": seed, "count": len(got),
            "elapsed": round(time.time() - t0, 1),
